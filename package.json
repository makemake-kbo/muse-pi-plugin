{
  "name": "pi-muse-provider",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "CHANGELOG.md"
  ],
  "type": "module",
  "description": "Muse request attribution and subscription usage for Pi",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "capture:muse": "tsx scripts/capture-muse.ts",
    "check:live": "tsx scripts/live-check.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
